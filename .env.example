# ─── GONDOLE KEY — réglages du serveur ───
# Génère MASTER_KEY et ADMIN_PASSWORD avec :  npm run cles
# ⚠ Ne jamais perdre MASTER_KEY : sans elle, tous les téléphones doivent être réactivés.

MASTER_KEY=
ADMIN_PASSWORD=

# Adresse publique de Gondole Key (sert à fabriquer les liens d'activation)
PUBLIC_URL=https://key.gondole-one.com

# Dossier des données (sur Clever Cloud : le dossier du FS Bucket, ex. /app/data)
DATA_DIR=./data

# Durée de vie d'un code, en secondes
TOTP_PERIOD=17

# Nom affiché dans l'appli
ISSUER=Gondole One

PORT=8080
